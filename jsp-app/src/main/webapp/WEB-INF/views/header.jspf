<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,id.ac.its.mybook.*,id.ac.its.mybook.Module,id.ac.its.mybook.LibraryService.Actor" %>

<%@ page import="static id.ac.its.mybook.Security.escape,static id.ac.its.mybook.Ui.icon" %>

<%
    Actor me = (Actor) session.getAttribute("actor");
    String base = request.getContextPath();
    String active = String.valueOf(request.getAttribute("page"));
    Module currentModule = (Module) request.getAttribute("module");
    String pageTitle =
        currentModule != null
            ? currentModule.title()
            : active.equals("favorites")
              ? "Favorite Books"
              : active.equals("reports")
                ? "Library Reports"
                : "Dashboard";
%>

<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0066b3">
    <title><%= escape(pageTitle) %> · myBook</title>
    <link rel="icon" href="<%= base %>/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="<%= base %>/assets/app.css">
    <link rel="stylesheet" href="<%= base %>/assets/community.css">
    <script src="<%= base %>/assets/app.js" defer></script>
</head>

<body>
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="<%= base %>/app/dashboard">
            <span class="brand-icon"><%= icon("book") %></span>myBook
        </a>
        <div class="workspace">
            <span class="workspace-icon"><%= icon("building") %></span>
            <div>
                <strong>myBook Library</strong>
                <small>Library services</small>
            </div>
        </div>
        <div class="nav-label">MAIN MENU</div>
        <nav aria-label="Main navigation">
            <a class="nav-item <%= active.equals("dashboard") ? "active" : "" %>" href="<%= base %>/app/dashboard"><%= icon("grid") %>Dashboard
            </a>

            <%
                for (Module item : Module.ALL.values()) {
                    if (!LibraryService.allowed(me, item)) continue;
            %>
            <a class="nav-item <%= active.equals(item.key()) ? "active" : "" %>" href="<%= base %>/app/<%= item.key() %>">
                <%= icon(item.icon()) %><%= escape(me.member() && item.key().equals("books") ? "Browse Books" : item.title()) %></a>
            <% } %>

            <% if (Backend.LARAVEL && me.member()) { %>
            <a class="nav-item <%= active.equals("favorites") ? "active" : "" %>" href="<%= base %>/app/favorites"><%= icon("heart") %>Favorite Books</a>
            <% } %>
            <% if (!me.member()) { %>
            <a class="nav-item <%= active.equals("reports") ? "active" : "" %>" href="<%= base %>/app/reports"><%= icon("chart") %>Reports</a>
            <% } %>
        </nav>
        <div class="sidebar-bottom">
            <div class="avatar"><%= escape(me.name().substring(0, 1)) %></div>
            <div>
                <strong><%= escape(me.name()) %></strong>
                <small><%= LibraryService.label(me.role()) %></small>
            </div>
            <form method="post" action="<%= base %>/auth/logout">
                <input type="hidden" name="csrf" value="<%= escape(session.getAttribute("csrf")) %>">
                <button class="icon-button" title="Sign out" aria-label="Sign out"><%= icon("logout") %></button>
            </form>
        </div>
    </aside>
    <div class="app-shell">
        <header class="topbar">
            <div class="breadcrumb">
                <button class="icon-button menu-toggle" aria-label="Open menu" aria-expanded="false"
                    aria-controls="sidebar"><%= icon("grid") %></button>
                <span>Library</span>
                <span class="breadcrumb-slash">/</span>
                <strong><%= escape(pageTitle) %></strong>
            </div>
            <div class="topbar-right">
                <span class="today"><%= java.time.LocalDate.now().format( java.time.format.DateTimeFormatter.ofPattern("EEEE, dd MMM yyyy", Locale.forLanguageTag("en-US")) ) %></span>
                <span class="topbar-separator"></span>
                <div class="avatar small"><%= escape(me.name().substring(0, 1)) %></div>
            </div>
        </header>
        <main id="main">

            <% if (session.getAttribute("flash") != null) { %>
            <div class="alert success" role="status"><%= icon("check") %><%= escape(session.getAttribute("flash")) %></div>
            <%
                session.removeAttribute("flash");
                }
                if (session.getAttribute("flashError") != null) {
            %>
            <div class="alert error" role="alert"><%= escape(session.getAttribute("flashError")) %></div>
            <%
                session.removeAttribute("flashError");
                }
            %>
